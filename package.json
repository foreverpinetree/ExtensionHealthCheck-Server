    "express": "~4.15.2",
    "morgan": "~1.8.1",
    "parse-server": "^5.5.2",
    "parse-server-mailgun": "^2.4.15",
    "serve-favicon": "~2.4.2",
    "stripe": "^8.129.0"
  }
